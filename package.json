{
  "name": "chanq_page",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm db:seed:test:reset && pnpm build && playwright test",
    "check": "./scripts/check.sh",
    "content:import": "node --import tsx scripts/import-content.mts",
    "db:generate": "drizzle-kit generate",
    "db:check": "MIGRATION_DATABASE_URL=postgresql://schema-check@127.0.0.1:5433/unused TEST_MIGRATION_DATABASE_URL=postgresql://schema-check@127.0.0.1:5433/unused drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "DRIZZLE_DATABASE_TARGET=test drizzle-kit migrate",
    "db:local:up": "docker compose --env-file .env.local -f infrastructure/compose.local.yaml up -d --wait postgres",
    "db:local:down": "docker compose --env-file .env.local -f infrastructure/compose.local.yaml down",
    "db:roles:provision": "./scripts/provision-postgres-roles.sh",
    "db:status": "./scripts/postgres-status.sh",
    "db:seed:dev": "./scripts/seed-postgres.sh development --allow-seed",
    "db:seed:test:reset": "./scripts/seed-postgres.sh test --allow-reset",
    "db:seed:status": "./scripts/postgres-seed-status.sh",
    "db:test:schema": "./scripts/check-postgres-schema.sh",
    "db:test:migrations": "./scripts/check-postgres-migrations.sh --allow-temporary-databases",
    "db:test:permissions": "./scripts/check-postgres-permissions.sh",
    "db:test:seeds": "./scripts/check-postgres-seeds.sh --allow-fixture-reset",
    "db:test:repositories": "pnpm db:seed:test:reset && vitest run --config vitest.integration.config.mts",
    "db:test:integration": "pnpm db:test:migrations && pnpm db:test:permissions && pnpm db:test:seeds && pnpm db:test:schema && pnpm db:test:repositories"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "pg": "8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "^20",
    "@types/pg": "8.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "26.1.0",
    "prettier": "3.9.6",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5",
    "vitest": "4.1.10"
  }
}
