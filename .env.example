# Local PostgreSQL bootstrap values. Copy this file to .env.local and replace
# every placeholder before starting the local database.
POSTGRES_USER=root
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_DB=chanq_page
POSTGRES_TEST_DB=chanq_page_test
POSTGRES_PORT=5433

# Percent-encode reserved characters in passwords embedded in connection URLs.
DATABASE_URL=postgresql://root:replace-with-a-local-only-password@127.0.0.1:5433/chanq_page
TEST_DATABASE_URL=postgresql://root:replace-with-a-local-only-password@127.0.0.1:5433/chanq_page_test
